# MenQ Standard — line endings and binary handling.
# Text is stored and checked out with LF so hashes, inventories and
# deterministic release builds are identical on every platform.
* text=auto eol=lf

*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.zip    binary
*.pdf    binary

# Generated lockfile: review as a unit, never merge by hand.
pnpm-lock.yaml -diff linguist-generated=true merge=binary
