{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menq.studio/schemas/design-platform-registry.schema.json",
  "title": "MenQ Design Platform Phase A Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryId",
    "decision",
    "status",
    "canonicalSource",
    "generatedOutputsAreCanonical",
    "owners",
    "specifications",
    "packages",
    "constraints"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryId": { "type": "string", "minLength": 1 },
    "decision": { "const": "D-025" },
    "status": { "enum": ["Approved — Implementing"] },
    "canonicalSource": { "type": "string", "minLength": 1 },
    "generatedOutputsAreCanonical": { "const": false },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ownerId", "displayName", "authority", "scope"],
        "properties": {
          "ownerId": { "type": "string", "pattern": "^owner\\.[a-z0-9.-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["final", "maintainer", "domain", "consumer", "cross-cutting"] },
          "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "titleHy", "domain", "plane", "class", "ownerId", "lifecycle", "sourcePath", "dependencies", "validationProfile"],
        "properties": {
          "id": { "type": "string", "pattern": "^menq\\.design\\.spec\\.[a-z0-9.-]+\\.v[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "titleHy": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "plane": { "enum": ["Brand Core", "Tokens", "Primitives", "Components", "Patterns", "Delivery", "Cross-cutting"] },
          "class": { "enum": ["normative", "informative"] },
          "ownerId": { "type": "string" },
          "lifecycle": { "enum": ["Draft", "Approved — Implementing", "Locked", "Deprecated", "Superseded", "Archived"] },
          "sourcePath": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "validationProfile": { "type": "string", "minLength": 1 },
          "packageMappings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "boundary", "ownerId", "status", "dependsOn", "publicApi"],
        "properties": {
          "name": { "type": "string", "pattern": "^@menq/design-[a-z0-9-]+$" },
          "boundary": { "type": "string", "minLength": 1 },
          "ownerId": { "type": "string" },
          "status": { "enum": ["Planned", "Skeleton", "Preview", "Stable", "Deprecated"] },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "publicApi": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productNeutralCore", "canonicalLanguages", "noPrivateDeepImports", "twoConsumerValidationRequired", "ownerApprovalRequiredForMergeAndLock"],
      "properties": {
        "productNeutralCore": { "const": true },
        "canonicalLanguages": { "const": ["hy", "en"] },
        "noPrivateDeepImports": { "const": true },
        "twoConsumerValidationRequired": { "const": true },
        "ownerApprovalRequiredForMergeAndLock": { "const": true }
      }
    }
  }
}
